# =================================================================
# THE UNIQUE MENS WEAR - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Client Domain(s) for CORS (Comma-separated for multiple domains)
CLIENT_URL=https://the-unique-mens-wear.vercel.app,https://cloth-shop-frontend-beta.vercel.app,http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Self-Hosted Replica Set)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/cloth_shop_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cloth_shop_prod?retryWrites=true&w=majority

# MongoDB Connection Pool Configuration
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Rate Limiting (Requests per 15 minutes per IP)
RATE_LIMIT_MAX=1000

# JSON Web Token Secret (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# MUST be changed to a secure 32+ character random secret in production
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_chars
JWT_EXPIRE=30d

# Cloudinary Cloud Storage (For High-Resolution Fashion Garment Uploads)
# Obtain from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Live / Test Credentials (Live mode starts with rzp_live_)
# Obtain from Razorpay Dashboard: Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Transactional Email (SMTP / SendGrid / AWS SES / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@yourdomain.com
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=no-reply@theuniquemenswear.com
FROM_NAME="The Unique Mens Wear"

# Initial Super Admin Seed Credentials (Created on first boot if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SetAStrongAdminPassword2026!
